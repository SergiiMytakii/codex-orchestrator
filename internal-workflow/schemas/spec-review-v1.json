{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "verdict",
    "coverage",
    "defects",
    "reviewerSessionId",
    "acceptedRisks"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "verdict": {
      "type": "string",
      "enum": [
        "approved",
        "needs-work",
        "rejected"
      ]
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "defects": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "reviewerSessionId": {
      "type": "string",
      "minLength": 1
    },
    "acceptedRisks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "defectId",
          "rationale",
          "policy",
          "acceptedBy"
        ],
        "properties": {
          "defectId": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "policy": {
            "type": "string",
            "minLength": 1
          },
          "acceptedBy": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

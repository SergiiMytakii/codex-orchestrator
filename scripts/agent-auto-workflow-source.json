{
  "version": 2,
  "personalSkills": [
    "bug-root-cause-explainer",
    "code-review",
    "codebase-design",
    "diagnosing-bugs",
    "domain-modeling",
    "flutter-android-debug",
    "flutter-attach-session",
    "flutter-ios-debug",
    "grilling",
    "implement",
    "implement-spec",
    "plan",
    "plan-review",
    "prototype",
    "research",
    "tdd",
    "to-spec",
    "to-tickets",
    "ui-evidence-proof"
  ],
  "repositorySkills": [
    "acceptance-proof"
  ],
  "skillDependencies": {
    "bug-root-cause-explainer": [
      "diagnosing-bugs"
    ]
  },
  "sharedDocs": [
    "bug-workflow-routing.md",
    "bugfix-quality-gate.md",
    "coding-skill-routing.md",
    "confidence-rubric.md",
    "tool-usage.md"
  ],
  "sharedEvals": [],
  "profiles": {
    "implementer": "./scripts/runtime-workflow-overlays/profiles/implementer.toml",
    "spec_reviewer": "spec-reviewer.toml",
    "standards_reviewer": "standards-reviewer.toml"
  },
  "overlayRoot": "scripts/runtime-workflow-overlays",
  "adaptations": [
    {
      "id": "resolved-codex-home",
      "from": "<resolved-codex-home>",
      "to": "$CODEX_ORCHESTRATOR_WORKFLOW_ROOT"
    },
    {
      "id": "default-codex-home",
      "from": "<default-codex-home>",
      "to": "$CODEX_ORCHESTRATOR_WORKFLOW_ROOT"
    },
    {
      "id": "default-codex-skills",
      "from": "${CODEX_HOME:-$HOME/.codex}/skills",
      "to": "../../skills"
    },
    {
      "id": "codex-home-skills",
      "from": "$CODEX_HOME/skills",
      "to": "../../skills"
    },
    {
      "id": "default-codex-docs",
      "from": "${CODEX_HOME:-$HOME/.codex}/docs/agents/",
      "to": "../../docs/agents/"
    },
    {
      "id": "codex-home-docs",
      "from": "$CODEX_HOME/docs/agents/",
      "to": "../../docs/agents/"
    }
  ],
  "operations": {
    "implementation": {
      "entry": "operations/implementation/SKILL.md",
      "sourceSkill": "implement",
      "dependencySkills": [
        "acceptance-proof",
        "diagnosing-bugs",
        "tdd"
      ],
      "resources": [
        "docs/agents/bug-workflow-routing.md",
        "docs/agents/coding-skill-routing.md",
        "docs/agents/tool-usage.md"
      ],
      "outputSchema": "schemas/implementation-report-v1.json",
      "profile": "implementer",
      "reviewers": [
        "spec_reviewer",
        "standards_reviewer"
      ],
      "policy": {
        "sandboxMode": "workspace-write",
        "cwdClass": "worktree",
        "worktreeAccess": "write",
        "writableRootClasses": [
          "worktree"
        ],
        "runnerPostcondition": "change-set",
        "network": "loopback",
        "networkHosts": [
          "127.0.0.1",
          "::1",
          "localhost"
        ],
        "mcpTools": [],
        "approvalCeiling": "never",
        "externalWrite": false
      }
    }
  }
}

{
  "version": 2,
  "personalSkills": [
    "bug-root-cause-explainer",
    "code-review",
    "diagnosing-bugs",
    "grilling",
    "implement",
    "plan",
    "prototype",
    "research",
    "tdd",
    "tickets-orchestrator",
    "to-spec",
    "to-tickets"
  ],
  "repositorySkills": ["acceptance-proof"],
  "skillDependencies": {
    "bug-root-cause-explainer": ["diagnosing-bugs"]
  },
  "sharedDocs": [
    "bug-workflow-routing.md",
    "bugfix-quality-gate.md",
    "coding-skill-routing.md",
    "confidence-rubric.md",
    "tool-usage.md"
  ],
  "sharedEvals": [],
  "profiles": {
    "implementer": "implementer.toml",
    "review_coordinator": "./scripts/runtime-workflow-overlays/profiles/review_coordinator.toml",
    "spec_reviewer": "spec-reviewer.toml",
    "standards_reviewer": "standards-reviewer.toml"
  },
  "overlayRoot": "scripts/runtime-workflow-overlays",
  "adaptations": [
    { "id": "resolved-codex-home", "from": "<resolved-codex-home>", "to": "$CODEX_ORCHESTRATOR_WORKFLOW_ROOT" },
    { "id": "default-codex-home", "from": "<default-codex-home>", "to": "$CODEX_ORCHESTRATOR_WORKFLOW_ROOT" },
    { "id": "default-codex-skills", "from": "${CODEX_HOME:-$HOME/.codex}/skills", "to": "../../skills" },
    { "id": "codex-home-skills", "from": "$CODEX_HOME/skills", "to": "../../skills" },
    { "id": "default-codex-docs", "from": "${CODEX_HOME:-$HOME/.codex}/docs/agents/", "to": "../../docs/agents/" },
    { "id": "codex-home-docs", "from": "$CODEX_HOME/docs/agents/", "to": "../../docs/agents/" }
  ],
  "operations": {
    "acceptance-proof": {
      "entry": "operations/acceptance-proof/SKILL.md",
      "sourceSkill": "acceptance-proof",
      "dependencySkills": [],
      "resources": [],
      "outputSchema": "schemas/proof-report-v1.json",
      "profile": "implementer",
      "reviewers": [],
      "policy": {
        "sandboxMode": "workspace-write",
        "cwdClass": "worktree",
        "worktreeAccess": "write",
        "writableRootClasses": ["worktree"],
        "runnerPostcondition": "proof-only",
        "network": "deny",
        "networkHosts": [],
        "mcpTools": [],
        "approvalCeiling": "never",
        "externalWrite": false
      }
    },
    "code-review": {
      "entry": "operations/code-review/SKILL.md",
      "sourceSkill": "code-review",
      "dependencySkills": [],
      "resources": ["docs/agents/confidence-rubric.md"],
      "outputSchema": "schemas/code-review-v1.json",
      "profile": "review_coordinator",
      "reviewers": ["spec_reviewer", "standards_reviewer"],
      "policy": {
        "sandboxMode": "read-only",
        "cwdClass": "worktree",
        "worktreeAccess": "read-only",
        "writableRootClasses": [],
        "runnerPostcondition": "report-only",
        "network": "deny",
        "networkHosts": [],
        "mcpTools": [],
        "approvalCeiling": "never",
        "externalWrite": false
      }
    },
    "implementation": {
      "entry": "operations/implementation/SKILL.md",
      "sourceSkill": "implement",
      "dependencySkills": ["diagnosing-bugs", "tdd"],
      "resources": [
        "docs/agents/bug-workflow-routing.md",
        "docs/agents/coding-skill-routing.md",
        "docs/agents/tool-usage.md"
      ],
      "outputSchema": "schemas/implementation-report-v1.json",
      "profile": "implementer",
      "reviewers": [],
      "policy": {
        "sandboxMode": "workspace-write",
        "cwdClass": "worktree",
        "worktreeAccess": "write",
        "writableRootClasses": ["worktree"],
        "runnerPostcondition": "change-set",
        "network": "deny",
        "networkHosts": [],
        "mcpTools": [],
        "approvalCeiling": "never",
        "externalWrite": false
      }
    }
  }
}
